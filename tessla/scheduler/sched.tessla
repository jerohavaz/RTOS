in task_create_id: Events[Int]
in task_create_prio: Events[Int]

in state_id: Events[Int]
in state_old: Events[Int]
in state_new: Events[Int]

in ready_id: Events[Int]
in ready_prio: Events[Int]

in running_id: Events[Int]
in running_prio: Events[Int]

in blocked_id: Events[Int]

in idle: Events[Bool]

in tick: Events[Int]

in isr_enter_id: Events[Int]
in isr_exit_mode: Events[Int]


def task_state_0: Events[Int] =
  merge(filter(state_new, state_id == 0), 0)

def ready_prio_0: Events[Int] =
  merge(filter(ready_prio, ready_id == 0), -1)

def running_prio_0: Events[Int] =
  merge(filter(running_prio, running_id == 0), -1)


def task_state_1: Events[Int] =
  merge(filter(state_new, state_id == 1), 0)

def ready_prio_1: Events[Int] =
  merge(filter(ready_prio, ready_id == 1), -1)

def running_prio_1: Events[Int] =
  merge(filter(running_prio, running_id == 1), -1)


def task_state_2: Events[Int] =
  merge(filter(state_new, state_id == 2), 0)

def ready_prio_2: Events[Int] =
  merge(filter(ready_prio, ready_id == 2), -1)

def running_prio_2: Events[Int] =
  merge(filter(running_prio, running_id == 2), -1)


def valid_state_transition :=
  if state_old == 0 then state_new == 1
  else if state_old == 1 then state_new == 2 || state_new == 3
  else if state_old == 2 then state_new == 1 || state_new == 3
  else if state_old == 3 then state_new == 1
  else false

def violation_invalid_state_transition :=
  filter(state_id, valid_state_transition == false)

def invalid_state_transition_check_marker :=
  if state_id >= 0 then 1
  else 0

def FAIL_invalid_state_transition :=
  filter(invalid_state_transition_check_marker, valid_state_transition == false)

def PASS_invalid_state_transition :=
  filter(invalid_state_transition_check_marker, valid_state_transition == false == false)



def running_id_out_of_range :=
  running_id < 0 || running_id >= 3

def violation_running_id_out_of_range :=
  filter(running_id, running_id_out_of_range)

def running_id_out_of_range_check_marker :=
  if running_id >= 0 then 1
  else 0

def FAIL_running_id_out_of_range :=
  filter(running_id_out_of_range_check_marker, running_id_out_of_range)

def PASS_running_id_out_of_range :=
  filter(running_id_out_of_range_check_marker, running_id_out_of_range == false)



def ready_event_inconsistent :=
  (ready_id == 0 && last(task_state_0, ready_id) != 1) ||
  (ready_id == 1 && last(task_state_1, ready_id) != 1) ||
  (ready_id == 2 && last(task_state_2, ready_id) != 1)

def running_event_inconsistent :=
  (running_id == 0 && last(task_state_0, running_id) != 2) ||
  (running_id == 1 && last(task_state_1, running_id) != 2) ||
  (running_id == 2 && last(task_state_2, running_id) != 2)

def blocked_event_inconsistent :=
  (blocked_id == 0 && last(task_state_0, blocked_id) != 3) ||
  (blocked_id == 1 && last(task_state_1, blocked_id) != 3) ||
  (blocked_id == 2 && last(task_state_2, blocked_id) != 3)

def violation_ready_event_inconsistent :=
  filter(ready_id, ready_event_inconsistent)

def violation_running_event_inconsistent :=
  filter(running_id, running_event_inconsistent)

def violation_blocked_event_inconsistent :=
  filter(blocked_id, blocked_event_inconsistent)

def ready_event_inconsistent_check_marker :=
  if ready_id >= 0 then 1
  else 0

def FAIL_ready_event_inconsistent :=
  filter(ready_event_inconsistent_check_marker, ready_event_inconsistent)

def PASS_ready_event_inconsistent :=
  filter(ready_event_inconsistent_check_marker, ready_event_inconsistent == false)


def running_event_inconsistent_check_marker :=
  if running_id >= 0 then 1
  else 0

def FAIL_running_event_inconsistent :=
  filter(running_event_inconsistent_check_marker, running_event_inconsistent)

def PASS_running_event_inconsistent :=
  filter(running_event_inconsistent_check_marker, running_event_inconsistent == false)


def blocked_event_inconsistent_check_marker :=
  if blocked_id >= 0 then 1
  else 0

def FAIL_blocked_event_inconsistent :=
  filter(blocked_event_inconsistent_check_marker, blocked_event_inconsistent)

def PASS_blocked_event_inconsistent :=
  filter(blocked_event_inconsistent_check_marker, blocked_event_inconsistent == false)



def blocked_task_running :=
  (running_id == 0 && last(task_state_0, running_id) == 3) ||
  (running_id == 1 && last(task_state_1, running_id) == 3) ||
  (running_id == 2 && last(task_state_2, running_id) == 3)

def violation_blocked_running :=
  filter(running_id, blocked_task_running)

def blocked_running_check_marker :=
  if running_id >= 0 then 1
  else 0

def FAIL_blocked_running :=
  filter(blocked_running_check_marker, blocked_task_running)

def PASS_blocked_running :=
  filter(blocked_running_check_marker, blocked_task_running == false)



def any_task_ready_at_idle :=
  (last(task_state_0, idle) == 1) ||
  (last(task_state_1, idle) == 1) ||
  (last(task_state_2, idle) == 1)

def idle_bad :=
  idle && any_task_ready_at_idle

def violation_idle_while_ready :=
  filter(idle, idle_bad)

def idle_while_ready_check_marker :=
  if idle then 1
  else 0

def FAIL_idle_while_ready :=
  filter(idle_while_ready_check_marker, idle_bad)

def PASS_idle_while_ready :=
  filter(idle_while_ready_check_marker, idle_bad == false)



def higher_priority_task_ready :=
  (running_id == 0 && last(task_state_1, running_id) == 1 && last(ready_prio_1, running_id) > running_prio) ||
  (running_id == 0 && last(task_state_2, running_id) == 1 && last(ready_prio_2, running_id) > running_prio) ||
  (running_id == 1 && last(task_state_0, running_id) == 1 && last(ready_prio_0, running_id) > running_prio) ||
  (running_id == 1 && last(task_state_2, running_id) == 1 && last(ready_prio_2, running_id) > running_prio) ||
  (running_id == 2 && last(task_state_0, running_id) == 1 && last(ready_prio_0, running_id) > running_prio) ||
  (running_id == 2 && last(task_state_1, running_id) == 1 && last(ready_prio_1, running_id) > running_prio)

def violation_priority :=
  filter(running_id, higher_priority_task_ready)

def priority_check_marker :=
  if running_id >= 0 then 1
  else 0

def FAIL_priority :=
  filter(priority_check_marker, higher_priority_task_ready)

def PASS_priority :=
  filter(priority_check_marker, higher_priority_task_ready == false)



def multiple_states_bad :=
  false

def ready_and_blocked_bad :=
  false

def violation_multiple_states :=
  filter(state_id, multiple_states_bad)

def violation_ready_and_blocked :=
  filter(state_id, ready_and_blocked_bad)

def multiple_states_check_marker :=
  if state_id >= 0 then 1
  else 0

def ready_and_blocked_check_marker :=
  if state_id >= 0 then 1
  else 0

def FAIL_multiple_states :=
  filter(multiple_states_check_marker, multiple_states_bad)

def PASS_multiple_states :=
  filter(multiple_states_check_marker, multiple_states_bad == false)

def FAIL_ready_and_blocked :=
  filter(ready_and_blocked_check_marker, ready_and_blocked_bad)

def PASS_ready_and_blocked :=
  filter(ready_and_blocked_check_marker, ready_and_blocked_bad == false)


def current_running: Events[Int] =
  merge(running_id, -1)

def current_running_prio: Events[Int] =
  merge(running_prio, -1)


def running_ticks: Events[Int] =
  merge(
    if running_id >= 0 then 0
    else if idle then 0
    else if tick > 0 then last(running_ticks, tick) + tick
    else 0,
    0
  )

def running_decision_count: Events[Int] =
  merge(
    if running_id >= 0 then last(running_decision_count, running_id) + 1
    else 0,
    0
  )

def same_priority_task_ready_at_tick :=
  (last(current_running, tick) == 0 && last(task_state_1, tick) == 1 && last(ready_prio_1, tick) == last(current_running_prio, tick)) ||
  (last(current_running, tick) == 0 && last(task_state_2, tick) == 1 && last(ready_prio_2, tick) == last(current_running_prio, tick)) ||
  (last(current_running, tick) == 1 && last(task_state_0, tick) == 1 && last(ready_prio_0, tick) == last(current_running_prio, tick)) ||
  (last(current_running, tick) == 1 && last(task_state_2, tick) == 1 && last(ready_prio_2, tick) == last(current_running_prio, tick)) ||
  (last(current_running, tick) == 2 && last(task_state_0, tick) == 1 && last(ready_prio_0, tick) == last(current_running_prio, tick)) ||
  (last(current_running, tick) == 2 && last(task_state_1, tick) == 1 && last(ready_prio_1, tick) == last(current_running_prio, tick))

def quantum_due :=
  tick > 0 &&
  last(current_running, tick) >= 0 &&
  last(running_ticks, tick) + tick >= 1 &&
  same_priority_task_ready_at_tick

def rr_due_task: Events[Int] =
  merge(
    if quantum_due then last(current_running, tick)
    else -1,
    -1
  )

def rr_due_decision_count: Events[Int] =
  merge(
    if quantum_due then last(running_decision_count, tick) + 1
    else -1,
    -1
  )

def current_running_decision_count :=
  last(running_decision_count, running_id) + 1

def rr_bad :=
  running_id >= 0 &&
  last(rr_due_decision_count, running_id) == current_running_decision_count &&
  last(rr_due_task, running_id) >= 0 &&
  running_id == last(rr_due_task, running_id)

def violation_quantum :=
  filter(running_id, rr_bad)

def violation_round_robin :=
  filter(running_id, rr_bad)

def quantum_check_marker :=
  if running_id >= 0 then 1
  else 0

def FAIL_quantum :=
  filter(quantum_check_marker, rr_bad)

def PASS_quantum :=
  filter(quantum_check_marker, rr_bad == false)


def round_robin_check_marker :=
  if running_id >= 0 then 1
  else 0

def FAIL_round_robin :=
  filter(round_robin_check_marker, rr_bad)

def PASS_round_robin :=
  filter(round_robin_check_marker, rr_bad == false)



def isr_has_entered: Events[Bool] =
  merge(
    if isr_enter_id >= 0 then true
    else false,
    false
  )

def isr_exit_without_enter :=
  isr_exit_mode >= 0 &&
  last(isr_has_entered, isr_exit_mode) != true

def isr_resume_violation_marker :=
  if isr_exit_without_enter then 1
  else 0

def violation_isr_resume :=
  filter(isr_resume_violation_marker, isr_exit_without_enter)

def isr_resume_check_marker :=
  if isr_exit_mode >= 0 then 1
  else 0

def FAIL_isr_resume :=
  filter(isr_resume_check_marker, isr_exit_without_enter)

def PASS_isr_resume :=
  filter(isr_resume_check_marker, isr_exit_without_enter == false)


out FAIL_running_id_out_of_range
out PASS_running_id_out_of_range
out FAIL_invalid_state_transition
out PASS_invalid_state_transition
out FAIL_ready_event_inconsistent
out PASS_ready_event_inconsistent
out FAIL_running_event_inconsistent
out PASS_running_event_inconsistent
out FAIL_blocked_event_inconsistent
out PASS_blocked_event_inconsistent
out FAIL_blocked_running
out PASS_blocked_running
out FAIL_idle_while_ready
out PASS_idle_while_ready
out FAIL_priority
out PASS_priority
out FAIL_multiple_states
out PASS_multiple_states
out FAIL_ready_and_blocked
out PASS_ready_and_blocked
out FAIL_quantum
out PASS_quantum
out FAIL_round_robin
out PASS_round_robin
out FAIL_isr_resume
out PASS_isr_resume
